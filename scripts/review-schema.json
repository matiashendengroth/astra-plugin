{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "coverage"],
  "properties": {
    "summary": { "type": "string", "description": "One or two sentences on overall state of the change." },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_read", "commands_run", "tests_run", "test_result", "confidence", "confidence_reason"],
      "properties": {
        "files_read": { "type": "array", "items": { "type": "string" }, "description": "Repo-relative paths the reviewer actually opened." },
        "commands_run": { "type": "array", "items": { "type": "string" }, "description": "Commands the reviewer actually ran." },
        "tests_run": { "type": "boolean" },
        "test_result": { "type": "string", "description": "passed, failed, not run, or a truthful free-text result." },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "confidence_reason": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "file", "line", "detail", "suggested_fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "file": { "type": "string", "description": "Path relative to the repo root." },
          "line": { "type": "integer", "description": "1-based line number, 0 if not applicable." },
          "detail": { "type": "string", "description": "Concrete failure scenario: inputs/state -> wrong behaviour." },
          "suggested_fix": { "type": "string" }
        }
      }
    }
  }
}
