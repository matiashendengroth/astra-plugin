#!/usr/bin/env bash
# Stable entry point for ASTRA. Installed to ~/.local/bin/astra by /astra-auto.
# Resolves the newest installed astra plugin at call time so plugin updates never break
# CLAUDE.md rules or permission entries that reference this path.
set -u
if [[ -n "${ASTRA_WRAPPER:-}" && -x "$ASTRA_WRAPPER" ]]; then exec "$ASTRA_WRAPPER" "$@"; fi
CACHE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache"
LATEST=""
for d in "$CACHE"/*/astra/*/scripts/astra; do
  [[ -x "$d" ]] || continue
  v="$(basename "$(dirname "$(dirname "$d")")")"
  if [[ -z "$LATEST" ]] || [[ "$(printf '%s\n%s\n' "$LATEST_V" "$v" | sort -V | tail -1)" == "$v" ]]; then LATEST="$d"; LATEST_V="$v"; fi
done
[[ -n "$LATEST" ]] || { echo "astra: no installed astra plugin found under $CACHE. Run: /plugin install astra@matias" >&2; exit 2; }
exec "$LATEST" "$@"
