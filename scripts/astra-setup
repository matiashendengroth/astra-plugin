#!/usr/bin/env bash
# astra-setup <project-dir> [on|off]  — one-shot, idempotent setup of automatic ASTRA delegation.
#   on : install stable launcher (~/.local/bin/astra), write/refresh the CLAUDE.md rule block,
#        add the permission allow rule, gitignore logs + worktrees.
#   off: remove the rule block and permission entries (launcher and .gitignore left alone).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DIR="${1:?usage: astra-setup <project-dir> [on|off]}"; ACTION="${2:-on}"
[[ -d "$DIR" ]] || { echo "astra-setup: no such directory: $DIR" >&2; exit 2; }
DIR="$(cd "$DIR" && pwd -P)"
LAUNCHER="$HOME/.local/bin/astra"
CLAUDE_MD="$DIR/CLAUDE.md"; SETTINGS="$DIR/.claude/settings.local.json"; IGNORE="$DIR/.gitignore"
START='<!-- astra-auto:start -->'; END='<!-- astra-auto:end -->'

strip_block() {  # remove existing block from CLAUDE.md if present
  [[ -f "$CLAUDE_MD" ]] || return 0
  python3 - "$CLAUDE_MD" "$START" "$END" <<'PY'
import re,sys; p,a,b=sys.argv[1:]; s=open(p).read()
s2=re.sub(r'\n*'+re.escape(a)+r'.*?'+re.escape(b)+r'\n?', '\n', s, flags=re.S).rstrip('\n')
open(p,'w').write(s2+'\n' if s2 else '')
PY
}
edit_perms() {  # $1 = add|remove
  mkdir -p "$(dirname "$SETTINGS")"
  python3 - "$SETTINGS" "$LAUNCHER" "$1" <<'PY'
import json,os,sys; p,l,op=sys.argv[1:]
s=json.load(open(p)) if os.path.exists(p) and os.path.getsize(p) else {}
a=s.setdefault("permissions",{}).setdefault("allow",[])
a=[r for r in a if not (("plugins/cache" in r and "scripts/astra" in r) or r==f"Bash({l}:*)")]
if op=="add": a.append(f"Bash({l}:*)")
s["permissions"]["allow"]=a; json.dump(s,open(p,"w"),indent=2); open(p,"a").write("\n")
PY
}

if [[ "$ACTION" == "off" ]]; then
  strip_block; edit_perms remove
  echo "ASTRA auto-delegation removed from $DIR"; exit 0
fi

[[ "$ACTION" == "on" ]] || { echo "astra-setup: action must be on|off" >&2; exit 2; }
command -v codex >/dev/null 2>&1 || echo "warning: codex CLI not found. Install: npm i -g @openai/codex ; then run: codex" >&2

# 1. stable launcher
mkdir -p "$(dirname "$LAUNCHER")"; cp "$HERE/astra-launcher" "$LAUNCHER"; chmod +x "$LAUNCHER"
CHECK="$("$LAUNCHER" -e turbo x 2>&1 || true)"   # wrapper exits 2 on purpose; we only need its text
if [[ "$CHECK" != *"bad effort"* ]]; then
  echo "astra-setup: launcher cannot find an installed astra plugin; run /plugin install astra@gryd first" >&2; exit 1
fi

# 2. CLAUDE.md rule (refresh in place)
REFRESH=0; [[ -f "$CLAUDE_MD" ]] && grep -q "$START" "$CLAUDE_MD" && REFRESH=1
strip_block
[[ -f "$CLAUDE_MD" && -s "$CLAUDE_MD" ]] && printf '\n' >> "$CLAUDE_MD"
sed "s#WRAPPER#$LAUNCHER#g" "$HERE/auto-rule.md" >> "$CLAUDE_MD"

# 3. permission
edit_perms add

# 4. gitignore
touch "$IGNORE"
grep -q '^\.claude/astra-logs/' "$IGNORE" || printf '\n# ASTRA (Codex) transcripts and build worktrees\n.claude/astra-logs/\n' >> "$IGNORE"
grep -q '^\.astra-wt/' "$IGNORE" || echo ".astra-wt/" >> "$IGNORE"

[[ $REFRESH -eq 1 ]] && echo "ASTRA auto-delegation refreshed in $DIR" || echo "ASTRA auto-delegation enabled in $DIR"
echo "launcher: $LAUNCHER  (takes effect in new sessions)"
