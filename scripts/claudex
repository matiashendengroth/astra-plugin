#!/usr/bin/env bash
# claudex — run one headless CLAUDEX (OpenAI Codex) pass and print only its final answer.
#
#   claudex [opts] "prompt"                 prompt as argument
#   echo "prompt" | claudex [opts]          prompt from stdin
#   claudex review [opts] [--uncommitted|--base BR|--commit SHA] ["focus"]
#   claudex status [-C DIR]               running/recent runs and build worktrees
#   claudex merge [-C DIR]                merge managed build worktrees
#   claudex budget [-C DIR]               completed run minutes used/limit in the last 24h
#   claudex ack [-C DIR]                  acknowledge the current changes without a review
#   claudex cancel [-C DIR] [--keep-worktrees]   stop everything, clean up worktrees
#   claudex limit [-C DIR] [--clear]      show (or clear) a Codex usage-limit pause
# Exit codes: 0 ok · 1 failed · 2 usage · 3 builder budget · 4 merge conflict · 5 Codex usage limit · 124 timeout · 130 cancelled
#   claudex build [opts] "spec"             implement a spec in DIR (workspace-write, effort default high,
#                                         timeout default 1200). Prints what it changed.
#
# Options
#   -C DIR     working root (default: cwd)
#   -w / --ro  force workspace-write / read-only sandbox
#              default: read-only for exec, workspace-write for review (so it can run tests)
#   -m MODEL   model override (default from ~/.codex/config.toml)
#   -e EFFORT  reasoning effort minimal|low|medium|high|xhigh
#              default: $CLAUDEX_EFFORT > .claude/claudex.conf effort= > low (exec) / medium (review) / high (build)
#              mode-specific: $CLAUDEX_REVIEW_EFFORT / $CLAUDEX_BUILD_EFFORT, review_effort= / build_effort=
#   -t SECS    timeout (default $CLAUDEX_TIMEOUT or 480; build: $CLAUDEX_BUILD_TIMEOUT or 1200).
#   --json     review only: return findings as JSON matching scripts/review-schema.json
#   --resume   continue the last done review/build session for DIR instead of starting cold:
#              review: sends only the current diff + your previous findings ("re-check");
#              build: sends the prompt as a follow-up (e.g. a test failure) to the same builder.
#   --no-packet review: skip the pre-assembled context packet (diff + changed files + conventions)
#   -v         verbose: print the full Codex transcript (commands run, file edits, reasoning
#              summaries) before the final answer, so it is visible in the caller's transcript
#
# Transcripts go to .claude/claudex-logs/ in the project (last 40 kept).
set -uo pipefail

die() { echo "claudex: $*" >&2; exit 2; }
# Find a Python 3 that actually RUNS. On Windows `python3` is often the Microsoft Store alias:
# it exists on PATH but only prints "Python was not found" — so existence is not enough.
find_python() {
  local c p
  for c in python3 python; do
    p="$(command -v "$c" 2>/dev/null)" || continue
    "$p" -c 'import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)' >/dev/null 2>&1 && { printf '%s\n' "$p"; return 0; }
  done
  if command -v py >/dev/null 2>&1; then   # Windows py launcher → real interpreter path
    p="$(py -3 -c 'import sys; print(sys.executable)' 2>/dev/null | tr -d '\r')"
    [[ -n "$p" ]] && "$p" -c 'import sys' >/dev/null 2>&1 && { printf '%s\n' "$p"; return 0; }
  fi
  return 1
}
PY="$(find_python)" || die "Python 3 not found or not runnable. On Windows the 'python3' on PATH is often the Microsoft Store alias; install Python from python.org or run: winget install Python.Python.3.12 (then reopen the terminal)"

# Read only transcript tool blocks; mentions in answers/tool output are not commands.
coverage() {
  "$PY" - "$1" <<'PY'
import re, shlex, sys
with open(sys.argv[1], encoding="utf-8", errors="replace") as f:
    lines = f.read().replace("\r", "").splitlines()
# Codex transcript framing: an "exec" header is followed by "<command> in <cwd>" (command may span
# lines) and usually a " succeeded in Nms:" / " exited N in Nms:" result line. An "apply patch"
# header is followed by "patch: completed" (or a patch body). Headers that are not followed by
# that framing are transcript content (e.g. a file being cat'ed), not tool calls.
RESULT = re.compile(r"^ (?:succeeded|exited \d+) in .*:$")
CMD_END = re.compile(r" in (?:/|[A-Za-z]:[\\/]|~)\S.*$")   # "... in /abs/dir" ends the command
HEADERS = ("exec", "apply patch", "thinking", "codex", "user", "tokens used", "file update")
RUNNER = re.compile(r"^(?:sudo\s+)?(?:pytest|py\.test|python3?\s+-m\s+(?:pytest|unittest)|npm\s+(?:run\s+)?test(?::\S+)?|yarn\s+(?:run\s+)?test(?::\S+)?|pnpm\s+(?:run\s+)?test(?::\S+)?|bun\s+(?:run\s+)?test(?::\S+)?|turbo\s+run\s+test(?::\S+)?|npx\s+(?:jest|vitest)|jest|vitest|node\s+--test|go\s+test|cargo\s+test|mvn\s+test|\.?/?gradlew?\s+test|dotnet\s+test|(?:bundle\s+exec\s+)?rspec|phpunit|make\s+test)(?:\s|$)")
def command_runs_tests(cmd):
    cmd = re.sub(r"^\S*(?:sh|bash|zsh|cmd(?:\.exe)?|powershell|pwsh)\s+(?:-\w+\s+)*", "", cmd)  # strip shell prefix
    cmd = cmd.strip().strip("'\"")
    for seg in re.split(r"\s*(?:;|&&|\|\||\||\n)\s*", cmd):
        seg = re.sub(r"^(?:cd\s+\S+\s*)$", "", seg).strip().lstrip("(").strip()
        if RUNNER.match(seg): return True
    return False
def command_executes(cmd):
    # Unwrap the shell used by Codex, then inspect command segments, never tool output.
    try:
        words = shlex.split(cmd)
    except ValueError:
        words = []
    if words and words[0].rsplit("/", 1)[-1] in ("bash", "sh", "zsh"):
        for i, word in enumerate(words[1:], 1):
            if word.startswith("-") and "c" in word and i + 1 < len(words):
                script = words[i + 1]
                # bash -c './script.sh' (also accepts an explicit sh/bash script).
                if words[0].rsplit("/", 1)[-1] in ("bash", "sh") and re.match(
                    r"^(?:(?:bash|sh)\s+(?!-)\S+|(?:\./|[\w.-]+/)[^\s;|&]+|[^\s;|&]+\.(?:sh|bash|py|js|ts|rb|php))(?:\s|$)", script):
                    return True
                if command_executes(script): return True
    runner = re.compile(r"^(?:python3?|node|deno|bun|ruby|php)(?:\s|$)|^(?:go\s+run|cargo\s+run|npx\s+(?:tsx|ts-node)|ts-node)(?:\s|$)")
    # package-manager verbs are not ad-hoc code execution (bun run build, bun install, node --version)
    # `bun run build` / `deno task x` run package scripts; `bun run x.ts` / `deno run x.ts` execute files
    pm_verb = re.compile(r"^(?:bun|node|deno)\s+(?:install|add|remove|i|x|update|upgrade|link|pm|task|--version|-v)(?:\s|$)"
                         r"|^bun\s+run\s+(?![^\s;|&]*[./])[^\s;|&]+(?:\s|$)")
    for segment in re.split(r"\s*(?:;|&&|\|\||\||\n)\s*", cmd):
        segment = segment.strip().lstrip("(").strip()
        if pm_verb.match(segment): continue
        if runner.match(segment): return True
        if segment != cmd.strip() and re.match(r"^(?:\S*/)?(?:bash|sh)\s", segment):
            if command_executes(segment): return True
    return False
DISCOVERY = re.compile(r"^(?:ls|pwd|find|tree|rg\s+--files|git\s+(?:status|log|ls-files|branch|diff\s+--stat)|cat\s+\S*(?:AGENTS|CLAUDE)\.md|wc)(?:\s|$)")
def command_discovers(cmd):
    cmd = re.sub(r"^\S*(?:sh|bash|zsh|cmd(?:\.exe)?|powershell|pwsh)\s+(?:-\w+\s+)*", "", cmd).strip().strip("'\"")
    segs = [x.strip().lstrip("(").strip() for x in re.split(r"\s*(?:;|&&|\|\||\||\n)\s*", cmd)]
    segs = [x for x in segs if x and not re.match(r"^(?:cd|pushd|popd)(?:\s|$)", x)]   # navigation is not discovery
    return bool(segs) and all(DISCOVERY.match(x) for x in segs)
exec_count = 0; tests_detected = False; executed = False; discovery = 0; paths = set()
i = 0
while i < len(lines):
    line = lines[i]
    if line == "exec":
        # collect the command: lines until one ends with " in <cwd>" or a result/header line
        j = i + 1; cmd = []
        while j < len(lines) and lines[j] not in HEADERS and not RESULT.match(lines[j]):
            cmd.append(lines[j])
            if CMD_END.search(lines[j]): break
            j += 1
            if len(cmd) > 200: break
        if cmd and CMD_END.search(cmd[-1]):           # framed like a real tool call
            exec_count += 1
            text = "\n".join(cmd); text = CMD_END.sub("", text, count=1) if len(cmd) == 1 else re.sub(CMD_END, "", text)
            tests_detected |= command_runs_tests(text)
            executed |= command_executes(text)
            discovery += 1 if command_discovers(text) else 0
            i = j + 1; continue
        i += 1; continue
    if line == "apply patch":
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if nxt.startswith("patch: ") or nxt == "*** Begin Patch":
            j = i + 1
            if nxt.startswith("patch: "):
                # "patch: completed" is followed by the absolute paths touched, then a cumulative diff
                j += 1
                while j < len(lines) and lines[j] and not lines[j].startswith("diff --git") and lines[j] not in HEADERS:
                    if re.match(r"(?:/|[A-Za-z]:[\\/]).+", lines[j]): paths.add(lines[j].strip())
                    j += 1
            else:
                while j < len(lines) and lines[j] not in HEADERS and lines[j] != "*** End Patch":
                    m = re.match(r"\*\*\* (?:(?:Add|Update|Delete) File|Move to): (.+)$", lines[j])
                    if m: paths.add(m.group(1))
                    j += 1
            i = j + 1; continue
        i += 1; continue
    i += 1
print(exec_count, "yes" if tests_detected else "no", "yes" if executed else "no", len(paths), discovery)
PY
}

# Hidden offline entry point: no Codex installation or run registry required.
if [[ "${1:-}" == coverage ]]; then
  [[ $# -eq 2 && -f "$2" ]] || die "usage: claudex coverage <logfile>"
  VALUES="$(coverage "$2")" || exit $?
  read -r EXEC_COUNT TESTS_DETECTED EXECUTED PATCHED DISCOVERY <<<"$VALUES"; export CLAUDEX_DISCOVERY="$DISCOVERY"
  echo "[claudex coverage: exec=$EXEC_COUNT tests=$TESTS_DETECTED executed=$EXECUTED patched=$PATCHED discovery=$DISCOVERY]"
  exit 0
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DIR="$PWD"; SANDBOX=""; MODEL_ARGS=(); MODE="exec"; REVIEW_ARGS=(); EFFORT=""; JSON=0; VERBOSE=0; RESUME=0; PACKET=1
TIMEOUT=""

case "${1:-}" in
  review|build) MODE="$1"; shift ;;
  status|cancel|budget|ack|merge|limit)  # local commands also work without Codex installed
    SUB="$1"; shift; SDIR="$PWD"; EXTRA=()
    while [[ $# -gt 0 ]]; do case "$1" in -C) SDIR="$2"; shift 2 ;; *) EXTRA+=("$1"); shift ;; esac; done
    exec "$PY" "$HERE/claudex-runs.py" "$SUB" "$SDIR" "${EXTRA[@]+"${EXTRA[@]}"}" ;;
esac
while [[ $# -gt 0 ]]; do
  case "$1" in
    -C) DIR="$2"; shift 2 ;;
    -w) SANDBOX="workspace-write"; shift ;;
    --ro) SANDBOX="read-only"; shift ;;
    -m) MODEL_ARGS=(-m "$2"); shift 2 ;;
    -e) EFFORT="$2"; shift 2 ;;
    -t) TIMEOUT="$2"; shift 2 ;;
    --json) JSON=1; shift ;;
    -v) VERBOSE=1; shift ;;
    --resume) RESUME=1; shift ;;
    --no-packet) PACKET=0; shift ;;
    --uncommitted) REVIEW_ARGS+=("$1"); shift ;;
    --base|--commit) REVIEW_ARGS+=("$1" "$2"); shift 2 ;;
    --) shift; break ;;
    -*) die "unknown option $1" ;;
    *) break ;;
  esac
done
[[ -d "$DIR" ]] || die "no such directory: $DIR"
DIR="$(cd "$DIR" && pwd -P)"
CONF="$DIR/.claude/claudex.conf"
conf() { [[ -f "$CONF" ]] && sed -n "s/^$1=//p" "$CONF" | tr -d '\r' | tail -1; }

# sandbox default per mode
if [[ -z "$SANDBOX" ]]; then
  if [[ "$MODE" == "review" ]]; then SANDBOX="${CLAUDEX_REVIEW_SANDBOX:-$(conf review_sandbox)}"; SANDBOX="${SANDBOX:-workspace-write}"
  elif [[ "$MODE" == "build" ]]; then SANDBOX="workspace-write"
  else SANDBOX="read-only"; fi
fi
if [[ -z "$TIMEOUT" ]]; then
  [[ "$MODE" == "build" ]] && TIMEOUT="${CLAUDEX_BUILD_TIMEOUT:-$(conf build_timeout)}"
  [[ -z "$TIMEOUT" ]] && TIMEOUT="${CLAUDEX_TIMEOUT:-$(conf timeout)}"
  TIMEOUT="${TIMEOUT:-480}"
fi

# effort: flag > env > conf > default (review has its own chain, falling back to the general one)
if [[ -z "$EFFORT" ]]; then
  if [[ "$MODE" == "review" ]]; then EFFORT="${CLAUDEX_REVIEW_EFFORT:-$(conf review_effort)}"; fi
  if [[ "$MODE" == "build" ]]; then EFFORT="${CLAUDEX_BUILD_EFFORT:-$(conf build_effort)}"; fi
  [[ -z "$EFFORT" ]] && EFFORT="${CLAUDEX_EFFORT:-$(conf effort)}"
  if [[ -z "$EFFORT" ]]; then case "$MODE" in review) EFFORT=medium ;; build) EFFORT=high ;; *) EFFORT=low ;; esac; fi
fi
case "$EFFORT" in minimal|low|medium|high|xhigh) ;; *) die "bad effort '$EFFORT' (minimal|low|medium|high|xhigh)" ;; esac
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || die "bad timeout '$TIMEOUT'"
command -v codex >/dev/null 2>&1 || die "codex CLI not found. Install: npm i -g @openai/codex  then run: codex  (to log in)"

PROMPT="${*:-}"
if [[ -z "$PROMPT" && "$MODE" != "review" && ! -t 0 ]]; then IFS= read -r -t 3 -d '' PROMPT || true; fi
[[ "$MODE" != "review" && -z "$PROMPT" ]] && die "no prompt given"

LOG_DIR="${CLAUDEX_LOG_DIR:-$DIR/.claude/claudex-logs}"; mkdir -p "$LOG_DIR"; LOG_DIR="$(cd "$LOG_DIR" && pwd -P)"
ls -t "$LOG_DIR" 2>/dev/null | tail -n +121 | while read -r f; do
  case "$f" in *.log|*.last.md|*.raw.md) rm -f "$LOG_DIR/$f" ;; esac
done   # keep last ~40 runs, but retain the registry for 24h budget accounting
STAMP="$(date +%Y%m%d-%H%M%S)-$$"; OUT="$LOG_DIR/$STAMP.last.md"; LOG="$LOG_DIR/$STAMP.log"

# Run registry: one JSON line per event in the MAIN repo (so builders in worktrees are visible
# together). Status/cancel read this. ROOT = main worktree of the repo containing DIR, else DIR.
ROOT="$DIR"
if WTS="$(git -C "$DIR" worktree list --porcelain 2>/dev/null)"; then
  MAIN="$(printf '%s\n' "$WTS" | sed -n 's/^worktree //p' | head -1)"
  [[ -n "$MAIN" ]] && ROOT="$MAIN"
fi
RUNS="$ROOT/.claude/claudex-logs/runs.jsonl"; mkdir -p "$(dirname "$RUNS")"

# Codex usage limit: when a previous run hit the limit we pause instead of burning retries.
LIMIT_FILE="$ROOT/.claude/claudex-logs/.limited"
limit_message() {  # prints the pause message if a limit is active, else returns 1
  [[ -f "$LIMIT_FILE" ]] || return 1
  local until; until="$(sed -n 's/^until=//p' "$LIMIT_FILE" | head -1)"
  if [[ "$until" =~ ^[0-9]+$ ]] && (( until > $(date +%s) )); then
    local mins=$(( (until - $(date +%s) + 59) / 60 ))
    echo "claudex: Codex usage limit reached — paused for about ${mins} min ($(sed -n 's/^reason=//p' "$LIMIT_FILE" | head -1)). Do NOT retry. Continue the task without CLAUDEX and tell the user that Codex review/build was skipped because of the usage limit. To resume early: claudex limit --clear -C \"$ROOT\""
    return 0
  fi
  rm -f "$LIMIT_FILE"; return 1
}
if MSG="$(limit_message)"; then echo "$MSG" >&2; exit 5; fi
"$PY" "$HERE/claudex-runs.py" budget "$ROOT" --warn-only
BUILDERS_LOCK="$ROOT/.claude/claudex-logs/.builders.lock"; LOCK_HELD=0
release_builders() {
  if [[ "$LOCK_HELD" == 1 ]]; then rmdir "$BUILDERS_LOCK" 2>/dev/null || true; LOCK_HELD=0; fi
}
trap release_builders EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
reserve_builder() {
  local lock_start=$SECONDS
  while :; do
    if mkdir "$BUILDERS_LOCK" 2>/dev/null; then LOCK_HELD=1; break; fi
    # Only lock expiry uses timestamps; review freshness is content-based.
    "$PY" - "$BUILDERS_LOCK" <<'PY'
import os, sys, time
try:
    if time.time() - os.stat(sys.argv[1]).st_mtime > 60: os.rmdir(sys.argv[1])
except OSError: pass
PY
    if (( SECONDS - lock_start >= 5 )); then
      echo "claudex: builder lock timed out after 5s; proceeding without lock" >&2
      break
    fi
    sleep 0.1
  done
  MAX_BUILDERS="$("$PY" "$HERE/claudex-runs.py" max-builders "$ROOT")" || exit $?
  RUNNING="$("$PY" "$HERE/claudex-runs.py" count-running "$ROOT" build)" || exit $?
  if (( RUNNING >= MAX_BUILDERS )); then
    echo "claudex: build budget reached ($RUNNING running); wait, raise max_builders in .claude/claudex.conf, or run claudex cancel" >&2
    exit 3
  fi
}
TOKEN="$("$PY" -c 'import secrets; print(secrets.token_hex(16))')"
TITLE="$(printf '%s' "${PROMPT:-review}" | head -1)"
record() {  # record <status> [duration [tokens rc [exec_count tests_detected executed patched]]]
  "$PY" - "$STAMP" "$1" "$MODE" "$EFFORT" "$SANDBOX" "$DIR" "$LOG" \
    "$$" "${PID:-0}" "$TITLE" "$TOKEN" "${PSTART:-}" "${WSTART:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" "${8:-}" "${REVIEW_SCOPE:-}" "${REVIEW_FINGERPRINT:-}" >> "$RUNS" <<'PY'
import json, os, sys, time
ident, status, mode, effort, sandbox, directory, log, wpid, pid, title, token, pstart, wstart, duration, tokens, rc, exec_count, tests_detected, executed, patched, scope, fingerprint = sys.argv[1:]
event = dict(id=ident, ts=time.time(), status=status, mode=mode, effort=effort,
             sandbox=sandbox, dir=os.path.realpath(directory), log=log, wpid=int(wpid), pid=int(pid), command="codex",
             title=title[:160], token=token, pstart=pstart.strip(), wstart=wstart.strip())
if mode == "review" and status == "done":
    event.update(scope=scope, fingerprint=fingerprint)
for key, value in (("duration", duration), ("tokens", tokens), ("rc", rc)):
    if value:
        try: event[key] = int(value)
        except ValueError: event[key] = 0
if exec_count:
    event.update(exec_count=int(exec_count), tests_detected=tests_detected == "yes", executed=executed == "yes", patched=int(patched))
    if os.environ.get("CLAUDEX_DISCOVERY", "").isdigit(): event["discovery"] = int(os.environ["CLAUDEX_DISCOVERY"])
import os as _os
if _os.environ.get("CLAUDEX_SESSION"): event["session"] = _os.environ["CLAUDEX_SESSION"]
if _os.environ.get("CLAUDEX_RESUMED"): event["resumed"] = _os.environ["CLAUDEX_RESUMED"]
print(json.dumps(event, separators=(",", ":")))
PY
}

COMMON=(--skip-git-repo-check -o "$OUT" -c "model_reasoning_effort=\"$EFFORT\"")
[[ ${#MODEL_ARGS[@]} -gt 0 ]] && COMMON+=("${MODEL_ARGS[@]}")

if [[ "$MODE" == "review" ]]; then
  [[ $JSON -eq 1 ]] && COMMON+=(--output-schema "$HERE/review-schema.json")
  [[ ${#REVIEW_ARGS[@]} -eq 0 ]] && REVIEW_ARGS=(--uncommitted)
  REVIEW_SCOPE="${REVIEW_ARGS[0]#--}"
  REVIEW_FINGERPRINT="$("$PY" "$HERE/claudex-runs.py" fingerprint "$DIR")" || die "could not fingerprint review directory"
  case "${REVIEW_ARGS[0]}" in
    --uncommitted) SCOPE="the uncommitted changes (staged, unstaged and untracked; see git status / git diff HEAD)" ;;
    --base) SCOPE="the changes on this branch relative to base branch ${REVIEW_ARGS[1]} (git diff ${REVIEW_ARGS[1]}...HEAD)" ;;
    --commit) SCOPE="the changes introduced by commit ${REVIEW_ARGS[1]} (git show ${REVIEW_ARGS[1]})" ;;
  esac
  SCOPE="$SCOPE. Ignore .claude/claudex-logs/"
  [[ "$SANDBOX" != "read-only" ]] && SCOPE="$SCOPE. You may run the project's tests/build to verify"
  # Static prefix first (identical across calls → provider prompt cache), then the packet, then focus.
  STATIC="You are doing an adversarial code review. Report concrete problems with file and line: logic errors, regressions, and edge cases that would crash or return wrong results (empty inputs, missing keys, None, division by zero, off-by-one) even if no current caller triggers them. Do not report style or speculation."
  [[ $JSON -eq 1 ]] && STATIC="$STATIC An empty findings array is correct when there is nothing concrete. Fill coverage truthfully: files_read lists only repo-relative paths you actually opened; commands_run lists commands you actually ran; tests_run and test_result describe tests you actually ran (use 'not run' otherwise). Set confidence to low if you did not run tests or did not read the changed files fully. Explain the scope and limitations in confidence_reason."
  if [[ $PACKET -eq 1 && $RESUME -eq 0 ]]; then
    PACKET_FILE="$LOG_DIR/$STAMP.packet.md"
    if ! "$PY" "$HERE/claudex-runs.py" packet "$DIR" "${REVIEW_ARGS[@]}" > "$PACKET_FILE" 2>"$PACKET_FILE.err"; then
      die "$(cat "$PACKET_FILE.err")"
    fi
    rm -f "$PACKET_FILE.err"
    STATIC="$STATIC
CONTEXT RULES: everything you need is in the CONTEXT PACKET below (project conventions, test command, changed-file list, full diff, and the post-change contents of every changed file). Do not run discovery commands (ls, find, pwd, rg --files, git status/log, searching for AGENTS.md); do not re-read files that are in the packet. Read a file outside the packet only when a specific finding requires it, and say which and why in confidence_reason. Run the test command if the sandbox allows it."
  fi
  FOCUS="Scope: $SCOPE. ${PROMPT:-Be adversarial: bugs, regressions, missed edge cases. Rank by severity.}"
  if [[ $RESUME -eq 1 ]]; then
    PREV="$("$PY" "$HERE/claudex-runs.py" last-session "$DIR" review)"; [[ -n "$PREV" ]] || die "no previous review session for $DIR to resume"
    RESUME_ID="$("$PY" -c 'import json,sys; print(json.loads(sys.argv[1])["session"])' "$PREV")"
    PREV_LAST="$("$PY" -c 'import json,sys; print(json.loads(sys.argv[1])["log"][:-4]+".last.md")' "$PREV")"
    export CLAUDEX_RESUMED="$RESUME_ID"
    CURDIFF="$("$PY" "$HERE/claudex-runs.py" scope-diff "$DIR" "${REVIEW_ARGS[@]}")" || die "could not compute the current diff for the resumed review"
    TEXT="RE-REVIEW (same session). Since your previous review the working tree changed. Re-check each of your previous findings against the CURRENT DIFF below and classify it: fixed, still open (with line), or changed. Add new findings only for concrete problems introduced by these changes. You already have the files in context; re-read only what the diff touches. Same output format as before.

## Your previous findings
$(cat "$PREV_LAST" 2>/dev/null | head -c 20000)

## Current diff vs HEAD
\`\`\`diff
$(printf '%s' "$CURDIFF" | head -c 120000)
\`\`\`
$FOCUS"
    CMD=(codex exec resume "$RESUME_ID" "${COMMON[@]}" -)
  else
    if [[ $PACKET -eq 1 ]]; then
      TEXT="$STATIC

# CONTEXT PACKET
$(cat "$PACKET_FILE")

# FOCUS
$FOCUS"
    else
      TEXT="$STATIC Review $SCOPE. $FOCUS"
    fi
    CMD=(codex exec "${COMMON[@]}" -C "$DIR" --color never -s "$SANDBOX" -)
  fi
  (cd "$DIR" && "${CMD[@]}" <<<"$TEXT") >"$LOG" 2>&1 &
elif [[ "$MODE" == "build" ]]; then
  COMMON+=(--output-schema "$HERE/build-schema.json")
  TEXT="You are implementing a change in this repository. Work only inside $DIR. Do not commit, do not touch .git, do not create branches. Follow the spec exactly; if something is ambiguous choose the simplest reasonable option and state the assumption. Run the project's tests/build if they exist and fix failures you introduced. Your final message must be JSON matching the supplied build schema: summary, files_changed (path, change: added|modified|deleted|renamed, why), commands_run, tests_run, test_result, assumptions, left_undone, and needs_attention (things the orchestrator must check). Report commands and results truthfully.

SPEC:
$PROMPT"
  if [[ $RESUME -eq 1 ]]; then
    PREV="$("$PY" "$HERE/claudex-runs.py" last-session "$DIR" build)"; [[ -n "$PREV" ]] || die "no previous build session for $DIR to resume"
    RESUME_ID="$("$PY" -c 'import json,sys; print(json.loads(sys.argv[1])["session"])' "$PREV")"
    export CLAUDEX_RESUMED="$RESUME_ID"
    TEXT="FOLLOW-UP (same build session, same directory and rules as before). Address the following, then re-run the relevant tests and report with the same JSON build schema:

$PROMPT"
    CMD=(codex exec resume "$RESUME_ID" "${COMMON[@]}" -)
    reserve_builder
    (cd "$DIR" && "${CMD[@]}" <<<"$TEXT") >"$LOG" 2>&1 &
  else
    CMD=(codex exec "${COMMON[@]}" -C "$DIR" --color never -s "$SANDBOX" -)
    reserve_builder
    "${CMD[@]}" <<<"$TEXT" >"$LOG" 2>&1 &
  fi
else
  CMD=(codex exec "${COMMON[@]}" -C "$DIR" --color never -s "$SANDBOX" -)
  "${CMD[@]}" <<<"$PROMPT" >"$LOG" 2>&1 &
fi
PID=$!
PSTART="$(ps -o lstart= -p "$PID" 2>/dev/null || true)"
WSTART="$(ps -o lstart= -p "$$" 2>/dev/null || true)"
T0=$(date +%s)
if ! record running; then kill "$PID" 2>/dev/null; die "could not record running process"; fi
release_builders

# portable timeout (macOS has no coreutils timeout)
ELAPSED=0
while kill -0 "$PID" 2>/dev/null; do
  if (( ELAPSED >= TIMEOUT )); then
    release_builders
    kill "$PID" 2>/dev/null; sleep 1; kill -9 "$PID" 2>/dev/null
    record timeout "$(( $(date +%s) - T0 ))"
    echo "claudex: timed out after ${TIMEOUT}s (effort=$EFFORT). Log tail:" >&2; tail -30 "$LOG" >&2
    echo "[claudex log: $LOG]" >&2; exit 124
  fi
  sleep 1; ELAPSED=$((ELAPSED+1))
done
wait "$PID"; RC=$?
TOKENS="$(tr -d '\r' < "$LOG" | awk '/^tokens used$/{getline; gsub(/,/,""); print; exit}')"; TOKENS="${TOKENS:-0}"
export CLAUDEX_SESSION="$(tr -d '\r' < "$LOG" | sed -n 's/^session id: //p' | head -1)"
DUR=$(( $(date +%s) - T0 ))
if grep "\"id\": *\"$STAMP\"" "$RUNS" 2>/dev/null | grep -q '"status": *"cancelled"'; then
  echo "claudex: cancelled after ${DUR}s" >&2; echo "[claudex log: $LOG]" >&2; exit 130
fi

COVERAGE_ARGS=()
if [[ "$MODE" == review || "$MODE" == build ]]; then
  VALUES="$(coverage "$LOG")" || die "could not measure coverage"
  read -r EXEC_COUNT TESTS_DETECTED EXECUTED PATCHED DISCOVERY <<<"$VALUES"; export CLAUDEX_DISCOVERY="$DISCOVERY"
  COVERAGE_ARGS=("$EXEC_COUNT" "$TESTS_DETECTED" "$EXECUTED" "$PATCHED")
  COVERAGE_LINE="[claudex coverage: exec=$EXEC_COUNT tests=$TESTS_DETECTED executed=$EXECUTED patched=$PATCHED discovery=$DISCOVERY]"
  [[ "$MODE" == review && "$PATCHED" -gt 0 ]] && echo "claudex: WARNING: review transcript contains patches to $PATCHED distinct path(s)" >&2
fi

if [[ -s "$OUT" ]]; then
  record done "$DUR" "$TOKENS" "$RC" "${COVERAGE_ARGS[@]+"${COVERAGE_ARGS[@]}"}"
  if [[ $VERBOSE -eq 1 ]]; then
    echo "===== CLAUDEX TRANSCRIPT ($MODE, effort=$EFFORT) ====="
    # print the transcript up to the token count; codex repeats the final answer after it
    tr -d '\r' < "$LOG" | awk '/^tokens used$/{exit} {print}'
    echo "===== CLAUDEX FINAL ANSWER ====="
  fi
  if [[ "$MODE" == build || ( "$MODE" == review && $JSON -eq 1 ) ]]; then
    "$PY" - "$OUT" "$EXEC_COUNT" "$TESTS_DETECTED" "$EXECUTED" "$PATCHED" "$COVERAGE_LINE" <<'PY'
import json, sys
path, exec_count, tests_detected, executed, patched, coverage_line = sys.argv[1:]
with open(path, encoding="utf-8") as f:
    answer = f.read()
try:
    result = json.loads(answer)
    if not isinstance(result, dict):
        raise ValueError("report must be a JSON object")
except ValueError:
    print(answer, end="")
    print("\n" + coverage_line)
else:
    result["measured"] = dict(exec_count=int(exec_count), tests_detected=tests_detected == "yes", executed=executed == "yes", patched=int(patched))
    merged = json.dumps(result, indent=2)
    raw = path[:-len(".last.md")] + ".raw.md" if path.endswith(".last.md") else path + ".raw"
    with open(raw, "w", encoding="utf-8") as f: f.write(answer)          # original model answer
    with open(path, "w", encoding="utf-8") as f: f.write(merged + "\n")  # RESULT now carries "measured"
    print(merged)
PY
  else
    cat "$OUT"; echo
    [[ "$MODE" == review ]] && echo "$COVERAGE_LINE"
  fi
  echo "[claudex log: $LOG | mode=$MODE effort=$EFFORT sandbox=$SANDBOX]"
else
  # Did Codex refuse because of a usage/rate limit? Only look at the end of a FAILED run's log.
  LIMIT_LINE="$(tr -d '\r' < "$LOG" | tail -60 | grep -iE "usage limit|rate limit|rate_limit|insufficient_quota|quota exceeded|too many requests|(^|[^0-9])429([^0-9]|$)|try again in" | tail -1 || true)"
  if [[ -n "$LIMIT_LINE" ]]; then
    WAIT="$("$PY" - "$LIMIT_LINE" <<'PYL'
import re, sys
t = sys.argv[1].lower(); secs = 0
for n, unit in re.findall(r"(\d+)\s*(day|hour|hr|minute|min|second|sec)s?", t.split("try again in")[-1] if "try again in" in t else ""):
    secs += int(n) * {"day": 86400, "hour": 3600, "hr": 3600, "minute": 60, "min": 60, "second": 1, "sec": 1}[unit]
print(min(max(secs, 0) or 900, 7 * 86400))   # unknown wait → 15 min; never more than a week
PYL
)"
    printf 'until=%s\nreason=%s\n' "$(( $(date +%s) + WAIT ))" "$(printf '%s' "$LIMIT_LINE" | cut -c1-200)" > "$LIMIT_FILE"
    record limited "$DUR" "$TOKENS" "$RC" "${COVERAGE_ARGS[@]+"${COVERAGE_ARGS[@]}"}" 2>/dev/null || true
    limit_message >&2 || true
    echo "[claudex log: $LOG]" >&2; exit 5
  fi
  record failed "$DUR" "$TOKENS" "$RC" "${COVERAGE_ARGS[@]+"${COVERAGE_ARGS[@]}"}"
  echo "claudex: no final message produced (exit $RC). Log tail:" >&2; tail -40 "$LOG" >&2; exit 1
fi
