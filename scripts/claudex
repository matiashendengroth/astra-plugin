#!/usr/bin/env bash
# claudex — run one headless CLAUDEX (OpenAI Codex) pass and print only its final answer.
#
#   claudex [opts] "prompt"                 prompt as argument
#   echo "prompt" | claudex [opts]          prompt from stdin
#   claudex review [opts] [--uncommitted|--base BR|--commit SHA] ["focus"]
#   claudex status [-C DIR]               running/recent runs and build worktrees
#   claudex cancel [-C DIR] [--keep-worktrees]   stop everything, clean up worktrees
#   claudex build [opts] "spec"             implement a spec in DIR (workspace-write, effort default high,
#                                         timeout default 1200). Prints what it changed.
#
# Options
#   -C DIR     working root (default: cwd)
#   -w / --ro  force workspace-write / read-only sandbox
#              default: read-only for exec, workspace-write for review (so it can run tests)
#   -m MODEL   model override (default from ~/.codex/config.toml)
#   -e EFFORT  reasoning effort minimal|low|medium|high|xhigh
#              default: $CLAUDEX_EFFORT > .claude/claudex.conf effort= > low (exec) / medium (review) / high (build)
#              mode-specific: $CLAUDEX_REVIEW_EFFORT / $CLAUDEX_BUILD_EFFORT, review_effort= / build_effort=
#   -t SECS    timeout (default $CLAUDEX_TIMEOUT or 480; build: $CLAUDEX_BUILD_TIMEOUT or 1200).
#   --json     review only: return findings as JSON matching scripts/review-schema.json
#   -v         verbose: print the full Codex transcript (commands run, file edits, reasoning
#              summaries) before the final answer, so it is visible in the caller's transcript
#
# Transcripts go to .claude/claudex-logs/ in the project (last 40 kept).
set -uo pipefail

die() { echo "claudex: $*" >&2; exit 2; }
PY="$(command -v python3 || command -v python)"; [[ -n "$PY" ]] || die "Python 3 required (install python3 or python)"

# Read only transcript tool blocks; mentions in answers/tool output are not commands.
coverage() {
  "$PY" - "$1" <<'PY'
import re, sys
with open(sys.argv[1], encoding="utf-8", errors="replace") as f:
    lines = f.read().replace("\r", "").splitlines()
# Codex transcript framing: an "exec" header is followed by "<command> in <cwd>" (command may span
# lines) and usually a " succeeded in Nms:" / " exited N in Nms:" result line. An "apply patch"
# header is followed by "patch: completed" (or a patch body). Headers that are not followed by
# that framing are transcript content (e.g. a file being cat'ed), not tool calls.
RESULT = re.compile(r"^ (?:succeeded|exited \d+) in .*:$")
CMD_END = re.compile(r" in (?:/|[A-Za-z]:[\\/]|~)\S.*$")   # "... in /abs/dir" ends the command
HEADERS = ("exec", "apply patch", "thinking", "codex", "user", "tokens used", "file update")
RUNNER = re.compile(r"^(?:sudo\s+)?(?:pytest|py\.test|python3?\s+-m\s+(?:pytest|unittest)|npm\s+(?:run\s+)?test|yarn\s+test|pnpm\s+test|npx\s+(?:jest|vitest)|jest|vitest|bun\s+test|node\s+--test|go\s+test|cargo\s+test|mvn\s+test|\.?/?gradlew?\s+test|dotnet\s+test|(?:bundle\s+exec\s+)?rspec|phpunit|make\s+test)(?:\s|$)")
def command_runs_tests(cmd):
    cmd = re.sub(r"^\S*(?:sh|bash|zsh|cmd(?:\.exe)?|powershell|pwsh)\s+(?:-\w+\s+)*", "", cmd)  # strip shell prefix
    cmd = cmd.strip().strip("'\"")
    for seg in re.split(r"\s*(?:;|&&|\|\||\||\n)\s*", cmd):
        seg = re.sub(r"^(?:cd\s+\S+\s*)$", "", seg).strip().lstrip("(").strip()
        if RUNNER.match(seg): return True
    return False
exec_count = 0; tests_detected = False; paths = set()
i = 0
while i < len(lines):
    line = lines[i]
    if line == "exec":
        # collect the command: lines until one ends with " in <cwd>" or a result/header line
        j = i + 1; cmd = []
        while j < len(lines) and lines[j] not in HEADERS and not RESULT.match(lines[j]):
            cmd.append(lines[j])
            if CMD_END.search(lines[j]): break
            j += 1
            if len(cmd) > 200: break
        if cmd and CMD_END.search(cmd[-1]):           # framed like a real tool call
            exec_count += 1
            text = "\n".join(cmd); text = CMD_END.sub("", text, count=1) if len(cmd) == 1 else re.sub(CMD_END, "", text)
            tests_detected |= command_runs_tests(text)
            i = j + 1; continue
        i += 1; continue
    if line == "apply patch":
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if nxt.startswith("patch: ") or nxt == "*** Begin Patch":
            j = i + 1
            if nxt.startswith("patch: "):
                # "patch: completed" is followed by the absolute paths touched, then a cumulative diff
                j += 1
                while j < len(lines) and lines[j] and not lines[j].startswith("diff --git") and lines[j] not in HEADERS:
                    if re.match(r"(?:/|[A-Za-z]:[\\/]).+", lines[j]): paths.add(lines[j].strip())
                    j += 1
            else:
                while j < len(lines) and lines[j] not in HEADERS and lines[j] != "*** End Patch":
                    m = re.match(r"\*\*\* (?:(?:Add|Update|Delete) File|Move to): (.+)$", lines[j])
                    if m: paths.add(m.group(1))
                    j += 1
            i = j + 1; continue
        i += 1; continue
    i += 1
print(exec_count, "yes" if tests_detected else "no", len(paths))
PY
}

# Hidden offline entry point: no Codex installation or run registry required.
if [[ "${1:-}" == coverage ]]; then
  [[ $# -eq 2 && -f "$2" ]] || die "usage: claudex coverage <logfile>"
  VALUES="$(coverage "$2")" || exit $?
  read -r EXEC_COUNT TESTS_DETECTED PATCHED <<<"$VALUES"
  echo "[claudex coverage: exec=$EXEC_COUNT tests=$TESTS_DETECTED patched=$PATCHED]"
  exit 0
fi
command -v codex >/dev/null 2>&1 || die "codex CLI not found. Install: npm i -g @openai/codex  then run: codex  (to log in)"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DIR="$PWD"; SANDBOX=""; MODEL_ARGS=(); MODE="exec"; REVIEW_ARGS=(); EFFORT=""; JSON=0; VERBOSE=0
TIMEOUT=""

case "${1:-}" in
  review|build) MODE="$1"; shift ;;
  status|cancel)  # delegate to the runs tool; accepts -C DIR and, for cancel, --keep-worktrees
    SUB="$1"; shift; SDIR="$PWD"; EXTRA=()
    while [[ $# -gt 0 ]]; do case "$1" in -C) SDIR="$2"; shift 2 ;; *) EXTRA+=("$1"); shift ;; esac; done
    exec "$PY" "$HERE/claudex-runs.py" "$SUB" "$SDIR" "${EXTRA[@]+"${EXTRA[@]}"}" ;;
esac
while [[ $# -gt 0 ]]; do
  case "$1" in
    -C) DIR="$2"; shift 2 ;;
    -w) SANDBOX="workspace-write"; shift ;;
    --ro) SANDBOX="read-only"; shift ;;
    -m) MODEL_ARGS=(-m "$2"); shift 2 ;;
    -e) EFFORT="$2"; shift 2 ;;
    -t) TIMEOUT="$2"; shift 2 ;;
    --json) JSON=1; shift ;;
    -v) VERBOSE=1; shift ;;
    --uncommitted) REVIEW_ARGS+=("$1"); shift ;;
    --base|--commit) REVIEW_ARGS+=("$1" "$2"); shift 2 ;;
    --) shift; break ;;
    -*) die "unknown option $1" ;;
    *) break ;;
  esac
done
[[ -d "$DIR" ]] || die "no such directory: $DIR"
DIR="$(cd "$DIR" && pwd -P)"
CONF="$DIR/.claude/claudex.conf"
conf() { [[ -f "$CONF" ]] && sed -n "s/^$1=//p" "$CONF" | tr -d '\r' | tail -1; }

# sandbox default per mode
if [[ -z "$SANDBOX" ]]; then
  if [[ "$MODE" == "review" ]]; then SANDBOX="${CLAUDEX_REVIEW_SANDBOX:-$(conf review_sandbox)}"; SANDBOX="${SANDBOX:-workspace-write}"
  elif [[ "$MODE" == "build" ]]; then SANDBOX="workspace-write"
  else SANDBOX="read-only"; fi
fi
if [[ -z "$TIMEOUT" ]]; then
  [[ "$MODE" == "build" ]] && TIMEOUT="${CLAUDEX_BUILD_TIMEOUT:-$(conf build_timeout)}"
  [[ -z "$TIMEOUT" ]] && TIMEOUT="${CLAUDEX_TIMEOUT:-$(conf timeout)}"
  TIMEOUT="${TIMEOUT:-480}"
fi

# effort: flag > env > conf > default (review has its own chain, falling back to the general one)
if [[ -z "$EFFORT" ]]; then
  if [[ "$MODE" == "review" ]]; then EFFORT="${CLAUDEX_REVIEW_EFFORT:-$(conf review_effort)}"; fi
  if [[ "$MODE" == "build" ]]; then EFFORT="${CLAUDEX_BUILD_EFFORT:-$(conf build_effort)}"; fi
  [[ -z "$EFFORT" ]] && EFFORT="${CLAUDEX_EFFORT:-$(conf effort)}"
  if [[ -z "$EFFORT" ]]; then case "$MODE" in review) EFFORT=medium ;; build) EFFORT=high ;; *) EFFORT=low ;; esac; fi
fi
case "$EFFORT" in minimal|low|medium|high|xhigh) ;; *) die "bad effort '$EFFORT' (minimal|low|medium|high|xhigh)" ;; esac
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || die "bad timeout '$TIMEOUT'"

PROMPT="${*:-}"
if [[ -z "$PROMPT" && "$MODE" != "review" && ! -t 0 ]]; then IFS= read -r -t 3 -d '' PROMPT || true; fi
[[ "$MODE" != "review" && -z "$PROMPT" ]] && die "no prompt given"

LOG_DIR="${CLAUDEX_LOG_DIR:-$DIR/.claude/claudex-logs}"; mkdir -p "$LOG_DIR"; LOG_DIR="$(cd "$LOG_DIR" && pwd -P)"
ls -t "$LOG_DIR" 2>/dev/null | tail -n +121 | while read -r f; do rm -f "$LOG_DIR/$f"; done   # keep last ~40 runs (log+last+raw)
STAMP="$(date +%Y%m%d-%H%M%S)-$$"; OUT="$LOG_DIR/$STAMP.last.md"; LOG="$LOG_DIR/$STAMP.log"

# Run registry: one JSON line per event in the MAIN repo (so builders in worktrees are visible
# together). Status/cancel read this. ROOT = main worktree of the repo containing DIR, else DIR.
ROOT="$DIR"
if WTS="$(git -C "$DIR" worktree list --porcelain 2>/dev/null)"; then
  MAIN="$(printf '%s\n' "$WTS" | sed -n 's/^worktree //p' | head -1)"
  [[ -n "$MAIN" ]] && ROOT="$MAIN"
fi
RUNS="$ROOT/.claude/claudex-logs/runs.jsonl"; mkdir -p "$(dirname "$RUNS")"
TOKEN="$("$PY" -c 'import secrets; print(secrets.token_hex(16))')"
TITLE="$(printf '%s' "${PROMPT:-review}" | head -1)"
record() {  # record <status> [duration [tokens rc [exec_count tests_detected patched]]]
  "$PY" - "$STAMP" "$1" "$MODE" "$EFFORT" "$SANDBOX" "$DIR" "$LOG" \
    "$$" "${PID:-0}" "$TITLE" "$TOKEN" "${PSTART:-}" "${WSTART:-}" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" >> "$RUNS" <<'PY'
import json, sys, time
ident, status, mode, effort, sandbox, directory, log, wpid, pid, title, token, pstart, wstart, duration, tokens, rc, exec_count, tests_detected, patched = sys.argv[1:]
event = dict(id=ident, ts=int(time.time()), status=status, mode=mode, effort=effort,
             sandbox=sandbox, dir=directory, log=log, wpid=int(wpid), pid=int(pid),
             title=title[:160], token=token, pstart=pstart.strip(), wstart=wstart.strip())
for key, value in (("duration", duration), ("tokens", tokens), ("rc", rc)):
    if value:
        try: event[key] = int(value)
        except ValueError: event[key] = 0
if exec_count:
    event.update(exec_count=int(exec_count), tests_detected=tests_detected == "yes", patched=int(patched))
print(json.dumps(event, separators=(",", ":")))
PY
}

COMMON=(--skip-git-repo-check -o "$OUT" -c "model_reasoning_effort=\"$EFFORT\"")
[[ ${#MODEL_ARGS[@]} -gt 0 ]] && COMMON+=("${MODEL_ARGS[@]}")

if [[ "$MODE" == "review" ]]; then
  [[ $JSON -eq 1 ]] && COMMON+=(--output-schema "$HERE/review-schema.json")
  [[ ${#REVIEW_ARGS[@]} -eq 0 ]] && REVIEW_ARGS=(--uncommitted)
  if [[ -n "$PROMPT" || $JSON -eq 1 ]]; then
    # a custom prompt cannot be combined with scope flags; fold the scope into the text
    case "${REVIEW_ARGS[0]}" in
      --uncommitted) SCOPE="the uncommitted changes (staged, unstaged and untracked; see git status / git diff HEAD)" ;;
      --base) SCOPE="the changes on this branch relative to base branch ${REVIEW_ARGS[1]} (git diff ${REVIEW_ARGS[1]}...HEAD)" ;;
      --commit) SCOPE="the changes introduced by commit ${REVIEW_ARGS[1]} (git show ${REVIEW_ARGS[1]})" ;;
    esac
    SCOPE="$SCOPE. Ignore .claude/claudex-logs/"
    [[ "$SANDBOX" != "read-only" ]] && SCOPE="$SCOPE. You may run the project's tests/build to verify"
    TEXT="Review $SCOPE. ${PROMPT:-Be adversarial: bugs, regressions, missed edge cases. Rank by severity.}"
    if [[ $JSON -eq 1 ]]; then
      # `codex exec review` ignores --output-schema, so structured reviews go through plain exec.
      TEXT="You are doing an adversarial code review. $TEXT Report concrete problems with file and line: logic errors, regressions, and edge cases that would crash or return wrong results (empty inputs, missing keys, None, division by zero, off-by-one) even if no current caller triggers them. Do not report style or speculation. An empty findings array is correct when there is nothing concrete. Fill coverage truthfully: files_read lists only repo-relative paths you actually opened; commands_run lists commands you actually ran; tests_run and test_result describe tests you actually ran (use 'not run' otherwise). Set confidence to low if you did not run tests or did not read the changed files fully. Explain the scope and limitations in confidence_reason."
      CMD=(codex exec "${COMMON[@]}" -C "$DIR" --color never -s "$SANDBOX" "$TEXT")
    else
      CMD=(codex exec -s "$SANDBOX" review "${COMMON[@]}" "$TEXT")
    fi
  else
    CMD=(codex exec -s "$SANDBOX" review "${COMMON[@]}" "${REVIEW_ARGS[@]}")
  fi
  (cd "$DIR" && "${CMD[@]}") >"$LOG" 2>&1 </dev/null &
elif [[ "$MODE" == "build" ]]; then
  TEXT="You are implementing a change in this repository. Work only inside $DIR. Do not commit, do not touch .git, do not create branches. Follow the spec exactly; if something is ambiguous choose the simplest reasonable option and state the assumption. Run the project's tests/build if they exist and fix failures you introduced. Finish with a short report: files changed (with one line each on what and why), commands you ran and their result, assumptions made, anything left undone.

SPEC:
$PROMPT"
  CMD=(codex exec "${COMMON[@]}" -C "$DIR" --color never -s "$SANDBOX" -)
  "${CMD[@]}" <<<"$TEXT" >"$LOG" 2>&1 &
else
  CMD=(codex exec "${COMMON[@]}" -C "$DIR" --color never -s "$SANDBOX" -)
  "${CMD[@]}" <<<"$PROMPT" >"$LOG" 2>&1 &
fi
PID=$!
PSTART="$(ps -o lstart= -p "$PID" 2>/dev/null || true)"
WSTART="$(ps -o lstart= -p "$$" 2>/dev/null || true)"
T0=$(date +%s); record running

# portable timeout (macOS has no coreutils timeout)
ELAPSED=0
while kill -0 "$PID" 2>/dev/null; do
  if (( ELAPSED >= TIMEOUT )); then
    kill "$PID" 2>/dev/null; sleep 1; kill -9 "$PID" 2>/dev/null
    record timeout "$(( $(date +%s) - T0 ))"
    echo "claudex: timed out after ${TIMEOUT}s (effort=$EFFORT). Log tail:" >&2; tail -30 "$LOG" >&2
    echo "[claudex log: $LOG]" >&2; exit 124
  fi
  sleep 1; ELAPSED=$((ELAPSED+1))
done
wait "$PID"; RC=$?
TOKENS="$(tr -d '\r' < "$LOG" | awk '/^tokens used$/{getline; gsub(/,/,""); print; exit}')"; TOKENS="${TOKENS:-0}"
DUR=$(( $(date +%s) - T0 ))
if grep "\"id\": *\"$STAMP\"" "$RUNS" 2>/dev/null | grep -q '"status": *"cancelled"'; then
  echo "claudex: cancelled after ${DUR}s" >&2; echo "[claudex log: $LOG]" >&2; exit 130
fi

COVERAGE_ARGS=()
if [[ "$MODE" == review ]]; then
  VALUES="$(coverage "$LOG")" || die "could not measure review coverage"
  read -r EXEC_COUNT TESTS_DETECTED PATCHED <<<"$VALUES"
  COVERAGE_ARGS=("$EXEC_COUNT" "$TESTS_DETECTED" "$PATCHED")
  COVERAGE_LINE="[claudex coverage: exec=$EXEC_COUNT tests=$TESTS_DETECTED patched=$PATCHED]"
  [[ "$PATCHED" -gt 0 ]] && echo "claudex: WARNING: review transcript contains patches to $PATCHED distinct path(s)" >&2
fi

if [[ -s "$OUT" ]]; then
  record done "$DUR" "$TOKENS" "$RC" "${COVERAGE_ARGS[@]+"${COVERAGE_ARGS[@]}"}"
  if [[ $VERBOSE -eq 1 ]]; then
    echo "===== CLAUDEX TRANSCRIPT ($MODE, effort=$EFFORT) ====="
    # print the transcript up to the token count; codex repeats the final answer after it
    tr -d '\r' < "$LOG" | awk '/^tokens used$/{exit} {print}'
    echo "===== CLAUDEX FINAL ANSWER ====="
  fi
  if [[ "$MODE" == review && $JSON -eq 1 ]]; then
    "$PY" - "$OUT" "$EXEC_COUNT" "$TESTS_DETECTED" "$PATCHED" "$COVERAGE_LINE" <<'PY'
import json, sys
path, exec_count, tests_detected, patched, coverage_line = sys.argv[1:]
with open(path, encoding="utf-8") as f:
    answer = f.read()
try:
    result = json.loads(answer)
    if not isinstance(result, dict):
        raise ValueError("review must be a JSON object")
except ValueError:
    print(answer, end="")
    print("\n" + coverage_line)
else:
    result["measured"] = dict(exec_count=int(exec_count), tests_detected=tests_detected == "yes", patched=int(patched))
    merged = json.dumps(result, indent=2)
    raw = path[:-len(".last.md")] + ".raw.md" if path.endswith(".last.md") else path + ".raw"
    with open(raw, "w", encoding="utf-8") as f: f.write(answer)          # original model answer
    with open(path, "w", encoding="utf-8") as f: f.write(merged + "\n")  # RESULT now carries "measured"
    print(merged)
PY
  else
    cat "$OUT"; echo
    [[ "$MODE" == review ]] && echo "$COVERAGE_LINE"
  fi
  echo "[claudex log: $LOG | mode=$MODE effort=$EFFORT sandbox=$SANDBOX]"
else
  record failed "$DUR" "$TOKENS" "$RC" "${COVERAGE_ARGS[@]+"${COVERAGE_ARGS[@]}"}"
  echo "claudex: no final message produced (exit $RC). Log tail:" >&2; tail -40 "$LOG" >&2; exit 1
fi
