#!/usr/bin/env bash
# Measure direct Claude edits without interfering with the tool's result.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PY="$(command -v python3 || command -v python || true)"
[[ -n "$PY" ]] || exit 0
"$PY" "$HERE/claudex-runs.py" guard-edit-hook unused >/dev/null 2>&1 || true
